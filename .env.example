# Conexao do Neon (PostgreSQL serverless).
# Copie este arquivo para .env e preencha os valores. Nunca versione o .env.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# URL publica da aplicacao. Usada na validacao de origem (CSRF).
# Em desenvolvimento o Vite serve em http://127.0.0.1:5173.
APP_ORIGIN=http://127.0.0.1:5173

# Porta e host da API.
# Em containers e PaaS use HOST=0.0.0.0 para escutar em todas as interfaces.
PORT=3000
HOST=127.0.0.1

# Ambiente: development, production ou test.
NODE_ENV=development

# Numero de proxies reversos na frente da aplicacao (0 = nenhum, 1 = nginx).
# Sem isso o rate limit ve o IP do proxy e o limite vira global.
TRUST_PROXY=0

# Limites de requisicao por janela de 15 minutos.
AUTH_RATE_LIMIT=10
RSVP_RATE_LIMIT=30

# Limite de tentativas de login por e-mail (por IP e e-mail).
LOGIN_EMAIL_RATE_LIMIT=20

# Limite do corpo JSON aceito nas requisicoes.
JSON_BODY_LIMIT=16kb
